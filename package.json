{
  "name": "fakebubble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/player-web/tsconfig.build.json --noEmit && tsc -p apps/player-web/tsconfig.tests.json",
    "test": "node --test --test-concurrency=1 tests/web/unit/*.test.ts tests/web/integration/*.test.ts tests/web/e2e/*.test.ts tests/web/load/*.test.ts apps/player-web/tests/components/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "web:local": "node scripts/web-v1.ts",
    "web:player:build": "node scripts/build-web-player.ts",
    "web:preview": "node scripts/preview-web.ts",
    "web:cloudflare:package": "node scripts/web-cloudflare-package.ts",
    "check:web:local-http": "node scripts/test-web-local-http.ts",
    "check:web:restart": "node scripts/test-web-data-lifecycle-restart.ts",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.10.1",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "description": "Web-only source preview; real-device acceptance is incomplete."
}
