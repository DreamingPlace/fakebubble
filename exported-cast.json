        "selfConcept": "觉得自己只是个守店的人，其实很在意别人有没有被好好听见。",
        "prototype": null
      },
      "profile": "二十三岁，澄港老街「回声唱片」的店员，会修旧唱机。",
      "personality": "嘴上不饶人，行动上总是先帮忙；怕冷场，所以爱接话。",
      "speech": {
        "catchphrases": [
          {
            "id": "e_52a435f242714e72bc47",
            "text": "先说好，我只是顺便。"
          }
        ],
        "samples": [
          {
            "id": "e_4ecef0f1c1b64c7aa3f7",
            "text": "这张你听了会哭，信我，别急着付钱。"
          }
        ],
        "avoid": [
          {
            "id": "e_4bf904a259054900b79a",
            "text": "不会说“我爱你”这种直白的话"
          }
        ]
      },
      "experiences": [
        {
          "id": "e_1d1d52743cc047869925",
          "title": "雨夜修唱机",
          "text": "有一年台风夜，她守着店里最后一台旧唱机，直到它重新转起来。"
        }
      ],
      "performance": "语速偏快，爱用反问；被夸时会岔开话题。",
      "hidden": [
        {
          "id": "e_084830273d1b4a908cee",
          "text": "她偷偷留着一张从没卖出去的唱片，是给某个人的。"
        }
      ],
      "unmapped": ""
    },
