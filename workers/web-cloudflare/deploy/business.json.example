{
  "name": "fakebubble-business",
  "main": "../business.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "INSTANCE_ID": "CONFIGURE_BEFORE_DEPLOY",
    "RECOVERY_EPOCH": "CONFIGURE_BEFORE_DEPLOY",
    "BUSINESS_OBJECT_ID": "CONFIGURE_BEFORE_DEPLOY",
    "ORIGIN": "https://fakebubble.example",
    "COOKIE_NAME": "__Host-paopao",
    "MATERIAL_PACKAGE_SHA256": "CONFIGURE_BEFORE_DEPLOY",
    "BUDGET_GRANT_HASHES": "CONFIGURE_BEFORE_DEPLOY",
    "BUDGET_POLICY": "test-cumulative",
    "PUBLIC_ENABLED": "false",
    "EXTERNAL_CALLS": "false",
    "OPERATOR_ENABLED": "false",
    "MAX_TEXT_RUNNING": "20",
    "MAX_AUDIO_RUNNING": "4",
    "MAX_WAITING_OPERATIONS": "104",
    "AUDIO_FALLBACK_WAIT_MS": "8000",
    "DAILY_REPLY_LIMIT": "100",
    "EMBEDDINGS_ENABLED": "false",
    "MAX_EMBED_RUNNING": "2",
    "EMBED_QUERY_TIMEOUT_MS": "3000",
    "PLAYER_SIGNUP_ENABLED": "false",
    "PLAYER_EMAIL_FROM": "CONFIGURE_BEFORE_ENABLING_SIGNUP",
    "PLAYER_EMAIL_DAILY_CAP": "200",
    "GUEST_GRACE_ENABLED": "false",
    "ACCOUNT_DELETE_ENABLED": "false",
    "LEGAL_PAGES_ENABLED": "false",
    "SIGNUP_BONUS_ENABLED": "false",
    "CHAT_REVIEW_ENABLED": "false",
    "ALERTS_ENABLED": "false",
    "ALERT_EMAIL_TO": "CONFIGURE_BEFORE_ENABLING_ALERTS",
    "ALERT_ERRORS_PER_HOUR": "20",
    "ALERT_DAILY_SPEND_MICROS": "5000000",
    "ALERT_BUDGET_PERCENT": "80",
    "ALERT_VALIDATION_FAIL_PERCENT": "20",
    "ALERT_VALIDATION_MIN_SAMPLES": "10",
    "ALERT_DIGEST_HOUR_UTC": "1",
    "TURNSTILE_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "CONFIGURE_BEFORE_ENABLING_TURNSTILE"
  },
  "send_email": [{ "name": "PLAYER_EMAIL" }],
  "durable_objects": { "bindings": [{ "name": "BUSINESS", "class_name": "WebBusinessObject" }] },
  "migrations": [{ "tag": "web113-v1", "new_sqlite_classes": ["WebBusinessObject"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "configure-before-deploy" }],
  "services": [
    { "binding": "BUDGET", "service": "fakebubble-budget", "entrypoint": "WebBudgetService" },
    { "binding": "GENERATION", "service": "fakebubble-generation", "entrypoint": "WebGenerationService" }
  ]
}
